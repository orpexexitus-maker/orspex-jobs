generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  role         Role
  createdAt    DateTime      @default(now())
  passwordHash String
  applications Application[] @relation("SeekerApplications")
  jobs         Job[]         @relation("EmployerJobs")
}

model Job {
  id           String        @id @default(cuid())
  title        String
  description  String
  location     String
  salaryMin    Int?
  salaryMax    Int?
  isActive     Boolean       @default(true)
  employerId   String
  createdAt    DateTime      @default(now())
  applications Application[]
  employer     User          @relation("EmployerJobs", fields: [employerId], references: [id])

  @@index([location])
  @@index([isActive])
}

model Application {
  id        String            @id @default(cuid())
  jobId     String
  seekerId  String
  status    ApplicationStatus @default(APPLIED)
  coverNote String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker    User              @relation("SeekerApplications", fields: [seekerId], references: [id], onDelete: Cascade)

  @@unique([jobId, seekerId])
  @@index([status])
}

enum Role {
  SEEKER
  EMPLOYER
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  INTERVIEW
  HIRED
  REJECTED
}
